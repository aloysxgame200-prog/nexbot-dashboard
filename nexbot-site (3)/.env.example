# ============================================================
#  Nexbot — variables d'environnement
#  Copiez ce fichier en `.env` (local) ou recopiez les variables
#  dans Vercel > Project > Settings > Environment Variables.
#  Ne publiez JAMAIS le fichier .env.
# ============================================================

# development | production   (production : cookies sécurisés, Premium de test coupé)
NEXBOT_ENV=development

# Clé secrète longue et aléatoire (sessions + chiffrement des tokens OAuth)
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Base de données PARTAGÉE par le bot et le Dashboard
#  - Local : SQLite
#  - Vercel : PostgreSQL obligatoire (ex. Neon, offre gratuite) — SQLite n'est pas persistant sur Vercel
DATABASE_URL=sqlite:///./nexbot.db
# DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Application Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# URL publique du Dashboard (sans / final). Le bot l'utilise pour la commande /dashboard.
DASHBOARD_URL=https://nexbot-dashboard-nexbotsite.vercel.app

# Bot uniquement : niveau de détail des journaux (INFO, WARNING, DEBUG)
LOG_LEVEL=INFO

SUPPORT_URL=https://discord.gg/BFDZ7577rZ

# Premium de test (propriétaire uniquement, ignoré en production)
PREMIUM_DEV_MODE=true

# Stripe — à remplir plus tard (laisser vide = paiements désactivés)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
